    {
      "parameters": {
        "jsCode": "// 1. Pull Claude's reply out, whatever shape this node version returns it in\nconst out = $json;\nlet text = out.content?.[0]?.text ?? out.message?.content ?? out.text ?? out.output;\n\nlet ai = text;\nif (typeof text === 'string') {\n  // Strip markdown fences if Claude wrapped the JSON\n  text = text.replace(/```json/gi, '').replace(/```/g, '').trim();\n  try {\n    ai = JSON.parse(text);\n  } catch (e) {\n    // Never let a malformed reply kill the run — log it and route it to spam_other\n    ai = {\n      classification: 'spam_other',\n      sender_company: 'unknown',\n      urgency: 'low',\n      one_line_summary: 'Could not parse AI response: ' + String(text).slice(0, 120),\n      requested_action: 'Manual review',\n    };\n  }\n}\n\n// 2. Merge the AI fields with the original email fields, safely — no string building\nconst email = $('Gmail Trigger').item.json;\n\nreturn {\n  json: {\n    timestamp: new Date().toISOString(),\n    from: email.From ?? email.from ?? '',\n    subject: email.Subject ?? email.subject ?? '(no subject)',\n    message_id: email.id ?? '',\n    classification: ai.classification ?? 'spam_other',\n    sender_company: ai.sender_company ?? 'unknown',\n    urgency: ai.urgency ?? 'low',\n    one_line_summary: ai.one_line_summary ?? '',\n    requested_action: ai.requested_action ?? '',\n  },\n};"
      },
